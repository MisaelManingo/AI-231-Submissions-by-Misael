# Copy to .env and fill in your own values (never commit .env)
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_LIVE_MODEL=models/gemini-3.8-live

# --- optional voice tools (see README "Optional voice tools"); each has an off switch ---
# CALL_NUMBER=+63XXXXXXXXXX            # phone for make_phone_call (ADB)
# MESSAGE_NUMBER=+63XXXXXXXXXX         # phone for send_sms (ADB)
# ME3_WEB_SEARCH=1                     # web/news search (Gemini grounding)
# ME3_IMAGE_GEN=1                      # image generation, shown as GUI overlay
# ME3_SOUND_GEN=1                      # sound clips (Lyria), played on the HDMI speaker
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# SOLOIST_API_KEY=your_soloist_api_key # from developer.spotify.com (Premium); never commit
# ME3_SPOTIFY_PLAY=0                   # disable Spotify playback (search stays)
# MUSIC_DEFAULT_VOLUME_PCT=35
